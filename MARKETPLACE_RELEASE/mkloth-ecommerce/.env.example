# Environment configuration examples - NEVER commit real secrets
# Copy this file to .env and fill in your actual values

# Database
# Local development uses SQLite (a file on disk).
DATABASE_URL=file:./prisma/dev.db
#
# Hosted deployments (Netlify / Vercel) need a Postgres database — SQLite files
# don't persist on serverless. When DATABASE_URL starts with `postgres`,
# prisma.config.ts automatically switches Prisma to schema.postgresql.prisma.
# Create a free database at https://neon.tech or https://supabase.com and paste
# its connection string here, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# NextAuth
# Generate with:  openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# Supabase (optional — only for Google OAuth sign-in)
# Leave these BLANK if you don't use Google sign-in. The Google login button
# and OAuth provider are hidden automatically when they are empty.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret from Supabase (used as the NextAuth client secret for Google OAuth)
SUPABASE_JWT_SECRET=

# Admin seed account (used by `npm run db:seed`)
# Default seeded password is `placeholder-admin-pass` unless this is overridden.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=placeholder-admin-pass